__pycache__/
*.pyc
*.pyo
.venv/
dist/
*.egg-info/
# Runtime call logs; code writes them under several parents (repo root,
# cluegen/, cluegen/local/, cluegen/scratch/), so match the name anywhere.
logs/
# Fine-tuning slices: generated data; the build_*slice scripts regenerate
# them.
cluegen/scratch/finetune/data/
# Trained LoRA adapters: multi-MB binaries, regenerable from data + config.
cluegen/scratch/finetune/adapters/
# Intermediate probe/sweep checkpoints: regenerable, not the final adapters.
cluegen/scratch/finetune/checkpoints/
